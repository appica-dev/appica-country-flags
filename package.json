{
  "name": "appica-country-flags",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:react": "pnpm --filter @appica/country-flags-react build && pnpm --filter @appica/country-flags-react exec pnpm pack",
    "release": "pnpm --filter @appica/country-flags-react publish"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "vitest": "^4.1.10"
  }
}
