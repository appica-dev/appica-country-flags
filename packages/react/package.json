{
  "name": "@appica/country-flags-react",
  "version": "1.0.0",
  "description": "Tree-shakeable SVG country flag components for React — use standalone or as part of the Appica UI.",
  "license": "MIT",
  "homepage": "https://appica.dev/ui/country-flags",
  "author": {
    "name": "Appica",
    "url": "https://appica.dev"
  },
  "keywords": [
    "country-flags",
    "flags",
    "svg",
    "react",
    "react-components",
    "typescript",
    "flag-icons",
    "world-flags",
    "i18n",
    "internationalization",
    "appica",
    "ui-components"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/appica-dev/appica-country-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/appica-dev/appica-country-flags.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flags/rounded": {
      "types": "./dist/flags/rounded/index.d.ts",
      "import": "./dist/flags/rounded/index.js"
    },
    "./flags/circle": {
      "types": "./dist/flags/circle/index.d.ts",
      "import": "./dist/flags/circle/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "codegen": "tsx scripts/build.ts",
    "build": "pnpm run codegen && tsup",
    "build:lib": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
