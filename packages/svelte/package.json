{
  "name": "@appica/country-flags-svelte",
  "version": "1.0.0",
  "description": "Tree-shakeable SVG country flag components for Svelte 5 — use standalone or as part of the Appica UI.",
  "license": "MIT",
  "homepage": "https://appica.dev/ui/country-flags",
  "author": {
    "name": "Appica",
    "url": "https://appica.dev"
  },
  "keywords": [
    "country-flags",
    "flags",
    "svg",
    "svelte",
    "svelte5",
    "svelte-components",
    "typescript",
    "flag-icons",
    "world-flags",
    "i18n",
    "internationalization",
    "appica",
    "ui-components"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/appica-dev/appica-country-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/appica-dev/appica-country-flags.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./flags/rounded": {
      "types": "./dist/flags/rounded/index.d.ts",
      "svelte": "./dist/flags/rounded/index.js",
      "default": "./dist/flags/rounded/index.js"
    },
    "./flags/circle": {
      "types": "./dist/flags/circle/index.d.ts",
      "svelte": "./dist/flags/circle/index.js",
      "default": "./dist/flags/circle/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "clean:generated": "rm -rf src/flags",
    "clean:dist": "rm -rf dist",
    "codegen": "tsx scripts/build.ts",
    "build": "pnpm run codegen && pnpm run build:lib",
    "build:lib": "svelte-package --input src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "pnpm run clean:generated && pnpm run clean:dist && pnpm run codegen && pnpm run typecheck && pnpm run test && pnpm run build:lib",
    "prepublishOnly": "pnpm run release:check"
  },
  "dependencies": {
    "esm-env": "^1.2.1"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
