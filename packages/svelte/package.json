{
  "name": "@appica/country-flags-svelte",
  "version": "1.0.0",
  "description": "Tree-shakeable SVG country flag components for Svelte — use standalone or as part of the Appica UI.",
  "license": "MIT",
  "homepage": "https://appica.dev/ui/country-flags",
  "author": {
    "name": "Appica",
    "url": "https://appica.dev"
  },
  "keywords": [
    "country-flags",
    "flags",
    "svg",
    "svelte",
    "svelte-components",
    "typescript",
    "flag-icons",
    "world-flags",
    "i18n",
    "internationalization",
    "appica",
    "ui-components"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/appica-dev/appica-country-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/appica-dev/appica-country-flags.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./flags/rounded": {
      "types": "./dist/flags/rounded/index.d.ts",
      "svelte": "./dist/flags/rounded/index.js"
    },
    "./flags/circle": {
      "types": "./dist/flags/circle/index.d.ts",
      "svelte": "./dist/flags/circle/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:generated": "rm -rf src/flags",
    "clean:dist": "rm -rf dist",
    "codegen": "tsx scripts/build.ts",
    "build": "pnpm run codegen && pnpm run build:lib",
    "build:lib": "svelte-package -i src -o dist && rm -rf dist/__tests__",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "pnpm run clean:generated && pnpm run clean:dist && pnpm run codegen && pnpm run typecheck && pnpm run test && pnpm run build:lib",
    "prepublishOnly": "pnpm run release:check"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.1.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
